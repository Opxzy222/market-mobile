import messaging from '@react-native-firebase/messaging';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { Platform } from 'react-native';

export const setupNotificationHandlers = async () => {
  try {
    // Request FCM permissions
    const authStatus = await messaging().requestPermission();
    const enabled =
      authStatus === messaging.AuthorizationStatus.AUTHORIZED ||
      authStatus === messaging.AuthorizationStatus.PROVISIONAL;
    if (!enabled) {
      console.log('FCM permission denied');
      return;
    }
    console.log('FCM permission granted');

    // Android: Register device and enable auto-init
    if (Platform.OS === 'android') {
      await messaging().registerDeviceForRemoteMessages();
      await messaging().setAutoInitEnabled(true);
    }

    // Background handler
    messaging().setBackgroundMessageHandler(async (remoteMessage) => {
      console.log('Background FCM message received:', JSON.stringify(remoteMessage, null, 2));
      try {
        if (remoteMessage?.notification) {
          const notification = {
            id: remoteMessage.data?.id || Math.random().toString(),
            type: remoteMessage.data?.type || 'unknown',
            message: remoteMessage.notification.title || 'Notification',
            shop_id: remoteMessage.data?.shop_id,
            receipt_id: remoteMessage.data?.receipt_id,
            created_at: new Date().toISOString(),
            is_read: false,
            meta_data: remoteMessage.data || {},
          };
          const storedNotifications = await AsyncStorage.getItem('notifications');
          let notifications = storedNotifications ? JSON.parse(storedNotifications) : [];
          if (!Array.isArray(notifications)) notifications = [];
          notifications = [notification, ...notifications];
          await AsyncStorage.setItem('notifications', JSON.stringify(notifications));
          console.log('Background notification stored:', notification);
        }
      } catch (error) {
        console.error('Error handling background FCM message:', error);
      }
    });

    // Handle notification taps when app is opened from background
    messaging().onNotificationOpenedApp((remoteMessage) => {
      console.log('App opened from notification:', JSON.stringify(remoteMessage, null, 2));
      if (remoteMessage?.data) {
        const { data } = remoteMessage;
        if (data?.type && data?.shop_id) {
          const router = require('expo-router').useRouter();
          if (['shop_post', 'shop_review', 'shop_follower'].includes(data.type)) {
            router.push({ pathname: '/shop/shop-page', params: { shopId: data.shop_id } });
          } else if (['receipt_created', 'receipt_status'].includes(data.type)) {
            router.push({
              pathname: data.type === 'receipt_status' && data.status === 'voided' ? '/shop/CustomerReceipts' : '/shop/ShopReceipts',
              params: { receiptId: data.receipt_id, shopId: data.shop_id },
            });
          }
        }
      }
    });

    // Handle notifications when app is terminated
    messaging().getInitialNotification().then((remoteMessage) => {
      if (remoteMessage?.data) {
        console.log('App opened from terminated state:', JSON.stringify(remoteMessage, null, 2));
        const { data } = remoteMessage;
        if (data?.type && data?.shop_id) {
          const router = require('expo-router').useRouter();
          if (['shop_post', 'shop_review', 'shop_follower'].includes(data.type)) {
            router.push({ pathname: '/shop/shop-page', params: { shopId: data.shop_id } });
          } else if (['receipt_created', 'receipt_status'].includes(data.type)) {
            router.push({
              pathname: data.type === 'receipt_status' && data.status === 'voided' ? '/shop/CustomerReceipts' : '/shop/ShopReceipts',
              params: { receiptId: data.receipt_id, shopId: data.shop_id },
            });
          }
        }
      }
    });
  } catch (error) {
    console.error('Error setting up notification handlers:', error);
  }
};