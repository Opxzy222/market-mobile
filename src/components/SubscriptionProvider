// components/SubscriptionProvider.tsx
import { createContext, useContext, useState, useEffect, useCallback } from 'react';
import AsyncStorage from '@react-native-async-storage/async-storage';

interface SubscriptionContextType {
  subscription: any;
  subscriptionStatus: string | null;
  loading: boolean;
  userId: number | null;
  refreshSubscription: () => void;
  resetSubscription: () => void;
}

const SubscriptionContext = createContext<SubscriptionContextType>({
  subscription: null,
  subscriptionStatus: null,
  loading: true,
  userId: null,
  refreshSubscription: () => {},
  resetSubscription: () => {},
});

const CACHE_KEY = "subscription_cache"; // We'll use multiSet, so key is part of the array
const LAST_REFRESH_KEY = "last_subscription_refresh";
const REFRESH_INTERVAL = 10 * 60 * 1000; // 10 minutes

const SubscriptionProvider = ({ children }) => {
  const [subscription, setSubscription] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [userId, setUserId] = useState<number | null>(null);

  const loadFromCache = async () => {
    try {
      const cachedData = await AsyncStorage.getItem(CACHE_KEY);
      if (cachedData) {
        const data = JSON.parse(cachedData);
        setSubscription(data);
        setUserId(data.user_id || null);
      }
    } catch (error) {
      console.error("Error loading subscription from cache:", error);
    }
  };

  const saveToCache = async (data: any) => {
    try {
      const { plan, is_active, start_date, end_date } = data;

      const cacheEntry = [
        CACHE_KEY,
        JSON.stringify({
          plan,
          is_active,
          start_date,
          end_date,
        }),
      ];

      await AsyncStorage.multiSet([cacheEntry]);
    } catch (error) {
      console.error("Error saving subscription to cache:", error);
    }
  };

  const fetchUserIdAndSubscription = async (forceRefresh = false) => {
    try {
      const userIdString = await AsyncStorage.getItem("user_id");
      if (!userIdString) {
        setSubscription(null);
        setUserId(null);
        setLoading(false);
        return;
      }

      const parsedUserId = parseInt(userIdString, 10);
      if (isNaN(parsedUserId)) {
        setSubscription(null);
        setUserId(null);
        setLoading(false);
        return;
      }

      setUserId(parsedUserId);

      const lastRefresh = await AsyncStorage.getItem(LAST_REFRESH_KEY);
      const lastRefreshTime = lastRefresh ? parseInt(lastRefresh, 10) : 0;
      const currentTime = Date.now();

      // Use cache if not expired and not forced
      if (!forceRefresh && currentTime - lastRefreshTime < REFRESH_INTERVAL) {
        console.log("Using cached subscription data");
        const cached = await AsyncStorage.getItem(CACHE_KEY);
        if (cached) {
          const parsed = JSON.parse(cached);
          setSubscription({ ...parsed, user_id: parsedUserId }); // restore full context
        }
        setLoading(false);
        return;
      }

      console.log("Fetching Subscription from Backend");
      const response = await fetch(`https://retail-alvinia-goza-f6a0e4f7.koyeb.app/check-subscription/${parsedUserId}/`);
      const data = await response.json();

      if (response.ok && data?.is_active !== undefined) {
        const fullSubscriptionData = { ...data, user_id: parsedUserId };
        setSubscription(fullSubscriptionData);

        // Save only the required fields in exact format
        await saveToCache(data);

        // Update last refresh timestamp
        await AsyncStorage.setItem(LAST_REFRESH_KEY, currentTime.toString());
      } else {
        setSubscription(null);
        await AsyncStorage.removeItem(CACHE_KEY);
      }
    } catch (error) {
      console.error("Error fetching subscription:", error);
    } finally {
      setLoading(false);
    }
  };

  const refreshSubscription = async () => {
    setLoading(true);
    await fetchUserIdAndSubscription(true);
  };

  const resetSubscription = useCallback(async () => {
    setSubscription(null);
    setUserId(null);
    setLoading(false);
    await AsyncStorage.multiRemove([CACHE_KEY, LAST_REFRESH_KEY]);
  }, []);

  // Initialize and listen for user_id changes
  useEffect(() => {
    let isMounted = true;

    const init = async () => {
      await loadFromCache();
      if (isMounted) await fetchUserIdAndSubscription();
    };
    init();

    // Listen for changes to user_id
    const listener = AsyncStorage.addEventListener?.('change', async (key) => {
      if (key === 'user_id' && isMounted) {
        console.log('user_id changed → refreshing subscription');
        await fetchUserIdAndSubscription(true);
      }
    });

    return () => {
      isMounted = false;
      listener?.remove();
    };
  }, []);

  return (
    <SubscriptionContext.Provider
      value={{
        subscription,
        subscriptionStatus: subscription
          ? (subscription.is_active ? subscription.plan : "inactive")
          : null,
        loading,
        userId,
        refreshSubscription,
        resetSubscription,
      }}
    >
      {children}
    </SubscriptionContext.Provider>
  );
};

export { SubscriptionContext };
export default SubscriptionProvider;