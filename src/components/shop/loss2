import React, { useState, useEffect, useCallback, useRef } from 'react';
import {
  View,
  TextInput,
  FlatList,
  Text,
  TouchableOpacity,
  StyleSheet,
  ActivityIndicator,
  Keyboard,
  Platform,
} from 'react-native';
import debounce from 'lodash.debounce';
import axios from 'axios';
import AsyncStorage from '@react-native-async-storage/async-storage';

// Initialize with fallbacks
let initializeDatabase = async () => {
  console.log('Fallback: Skipping database initialization');
};
let getSuggestions = async () => [];
let cacheSuggestions = async () => {
  console.error('Fallback failed: Storage module not loaded');
  throw new Error('Storage module not loaded');
};
let getSuggestionsCount = async () => 0;

try {
  const storage = require('../storage/storage');
  if (storage && typeof storage === 'object' && storage.initializeDatabase) {
    initializeDatabase = storage.initializeDatabase;
    getSuggestions = storage.getSuggestions || getSuggestions;
    cacheSuggestions = storage.cacheSuggestions || cacheSuggestions;
    getSuggestionsCount = storage.getSuggestionsCount || getSuggestionsCount;
  }
} catch (error) {
  console.error('Failed to load storage module:', error);
}

const AutocompleteInput = ({
  value,
  onChangeText,
  onSubmit,
  style,
  onFocusChange,
  inputRef,
  suggestionsRef,
  onSuggestionsStateChange,
}) => {
  const [suggestions, setSuggestions] = useState([]);
  const [loading, setIsLoading] = useState(false);
  const [isFocused, setIsFocused] = useState(false);
  const [error, setError] = useState(null);
  const flatListRef = useRef(null);

  useEffect(() => {
    const init = async () => {
      const initialized = await AsyncStorage.getItem('suggestions_initialized');
      if (initialized === 'true') return;
      try {
        await initializeDatabase();
        await populateInitialSuggestions();
        await AsyncStorage.setItem('suggestions_initialized', 'true');
      } catch (err) {
        console.error('Initialization failed:', err);
        setError('Failed to initialize suggestions');
        await populateInitialSuggestions(true);
      }
    };
    init();
  }, []);

  const populateInitialSuggestions = async (useAsyncStorage = false, retryCount = 0, maxRetries = 3) => {
    try {
      let count = useAsyncStorage
        ? (JSON.parse(await AsyncStorage.getItem('suggestions')) || []).length
        : await getSuggestionsCount();
      if (count >= 1000) return;

      setIsLoading(true);
      let response;
      try {
        response = await axios.get('https://retail-alvinia-goza-f6a0e4f7.koyeb.app/all-suggestions/', {
          timeout: 60000,
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'User-Agent': 'market-mobile/1.0.0' },
          validateStatus: status => status >= 200 && status < 300,
        });
      } catch (axiosError) {
        console.error('Axios fetch failed:', axiosError);
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 60000);
        const fetchResponse = await fetch('https://retail-alvinia-goza-f6a0e4f7.koyeb.app/all-suggestions/', {
          method: 'GET',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'User-Agent': 'market-mobile/1.0.0' },
          signal: controller.signal,
        });
        clearTimeout(timeoutId);
        if (!fetchResponse.headers.get('content-type')?.includes('application/json')) {
          throw new Error('Invalid response: Expected JSON');
        }
        response = { data: await fetchResponse.json() };
      }

      const rawSuggestions = response.data.suggestions
        .map(item => (item && typeof item.name === 'string' && item.name.trim() ? item.name.trim() : null))
        .filter(Boolean);
      const uniqueSuggestions = [...new Set(rawSuggestions.map(s => s.toLowerCase()))].map(s => rawSuggestions.find(r => r.toLowerCase() === s)).slice(0, 180000);

      if (useAsyncStorage) {
        await AsyncStorage.setItem('suggestions', JSON.stringify(uniqueSuggestions));
      } else {
        await cacheSuggestions(uniqueSuggestions);
      }
    } catch (error) {
      console.error('Error populating suggestions:', error);
      setError(`Failed to load suggestions: ${error.response?.status || 'Network error'}`);
      if (retryCount < maxRetries && !error.message.includes('NOT NULL constraint failed') && !error.message.includes('cannot start a transaction')) {
        setTimeout(() => populateInitialSuggestions(useAsyncStorage, retryCount + 1, maxRetries), Math.pow(2, retryCount) * 5000);
      } else if (!useAsyncStorage) {
        await populateInitialSuggestions(true, 0, maxRetries);
      }
    } finally {
      setIsLoading(false);
    }
  };

  const fetchSuggestions = useCallback(
    debounce(async (input) => {
      if (!input || input.length < 1) {
        setSuggestions([]);
        onSuggestionsStateChange?.({ showSuggestions: false, suggestions: [], suggestionsHeight: 0 });
        return;
      }
      setIsLoading(true);
      try {
        let results = await getSuggestions(input, 20, 0);
        if (results.length === 0) {
          const cached = await AsyncStorage.getItem('suggestions');
          if (cached) {
            results = JSON.parse(cached)
              .filter(name => name.toLowerCase().startsWith(input.toLowerCase()))
              .slice(0, 20);
          }
        }
        setSuggestions(results);
        const estimatedHeight = Math.min(results.length * 48 + 8, 240);
        onSuggestionsStateChange?.({ showSuggestions: results.length > 0, suggestions: results, suggestionsHeight: estimatedHeight });
      } catch (error) {
        console.error('Error fetching suggestions:', error);
        setError('Failed to fetch suggestions');
        setSuggestions([]);
        onSuggestionsStateChange?.({ showSuggestions: false, suggestions: [], suggestionsHeight: 0 });
      } finally {
        setIsLoading(false);
      }
    }, 300),
    [onSuggestionsStateChange]
  );

  const handleInput = text => {
    onChangeText(text);
    fetchSuggestions(text);
  };

  const handleSelectSuggestion = suggestion => {
    onChangeText(suggestion);
    setSuggestions([]);
    onSuggestionsStateChange?.({ showSuggestions: false, suggestions: [], suggestionsHeight: 0 });
    setIsFocused(false);
    onFocusChange?.(false);
    Keyboard.dismiss();
    onSubmit(suggestion);
  };

  const handleSubmitEditing = () => {
    if (value) {
      setSuggestions([]);
      onSuggestionsStateChange?.({ showSuggestions: false, suggestions: [], suggestionsHeight: 0 });
      setIsFocused(false);
      onFocusChange?.(false);
      onSubmit(value);
    }
  };

  const handleFocus = () => {
    setIsFocused(true);
    onFocusChange?.(true);
    if (value) fetchSuggestions(value);
  };

  const handleClear = () => {
    onChangeText('');
    setSuggestions([]);
    onSuggestionsStateChange?.({ showSuggestions: false, suggestions: [], suggestionsHeight: 0 });
    setIsFocused(false);
    onFocusChange?.(false);
    Keyboard.dismiss();
  };

  return (
    <View style={[styles.container, style]}>
      <View
        style={[styles.inputWrapper, isFocused && styles.inputWrapperFocused]}
        onStartShouldSetResponder={() => true}
        onResponderGrant={() => console.log('Input wrapper touched')}
      >
        <TextInput
          ref={inputRef}
          style={styles.input}
          value={value}
          onChangeText={handleInput}
          onFocus={handleFocus}
          onBlur={() => {
            console.log('Input blurred');
            setIsFocused(false);
            onFocusChange?.(false);
          }}
          onSubmitEditing={handleSubmitEditing}
          placeholder="What are you looking for?"
          placeholderTextColor="#777"
          returnKeyType="search"
        />
        {value && (
          <TouchableOpacity style={styles.clearButton} onPress={handleClear}>
            <Text style={styles.clearButtonText}>✕</Text>
          </TouchableOpacity>
        )}
        {loading && <ActivityIndicator size="small" color="#007bff" style={styles.loader} />}
      </View>
      {error && <Text style={styles.errorText}>{error}</Text>}
      {suggestions.length > 0 && (
        <View
          style={styles.suggestionsContainer}
          onStartShouldSetResponder={() => true}
          onResponderGrant={() => console.log('Suggestions container touched')}
        >
          <FlatList
            ref={suggestionsRef || flatListRef}
            data={suggestions}
            keyExtractor={(item, index) => `${item}-${index}`}
            renderItem={({ item }) => (
              <TouchableOpacity
                style={styles.suggestionItem}
                onPress={() => handleSelectSuggestion(item)}
                activeOpacity={0.7}
              >
                <Text style={styles.suggestionText}>{item}</Text>
              </TouchableOpacity>
            )}
            keyboardShouldPersistTaps="handled"
            scrollEnabled={true}
            nestedScrollEnabled={true}
            showsVerticalScrollIndicator={true}
            style={styles.suggestionsList}
            contentContainerStyle={styles.suggestionsContent}
            onScroll={e => console.log('Suggestions FlatList scrolled:', e.nativeEvent.contentOffset)}
            onContentSizeChange={(w, h) => console.log(`Suggestions content size: ${w}x${h}`)}
            onTouchStart={() => console.log('Suggestions FlatList touched')}
          />
        </View>
      )}
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    width: '100%',
  },
  inputWrapper: {
    flexDirection: 'row',
    alignItems: 'center',
    borderWidth: 1,
    borderColor: '#ccc',
    borderRadius: 8,
    backgroundColor: '#fff',
    paddingHorizontal: 10,
  },
  inputWrapperFocused: {
    borderColor: '#007bff',
    shadowColor: '#007bff',
    shadowOffset: { width: 0, height: 0 },
    shadowOpacity: 0.2,
    shadowRadius: 4,
    elevation: 8,
  },
  input: {
    flex: 1,
    height: 48,
    fontSize: 16,
    color: '#333',
  },
  clearButton: {
    padding: 8,
    justifyContent: 'center',
    alignItems: 'center',
  },
  clearButtonText: {
    fontSize: 16,
    color: '#777',
  },
  loader: {
    marginLeft: 10,
  },
  suggestionsContainer: {
    marginTop: 4,
    borderRadius: 12,
    backgroundColor: '#FFFFFF',
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.1,
    shadowRadius: 5,
    elevation: 4,
    maxHeight: 240,
  },
  suggestionsList: {
    maxHeight: 240,
  },
  suggestionsContent: {
    paddingBottom: 8,
  },
  suggestionItem: {
    paddingVertical: 12,
    paddingHorizontal: 12,
    borderBottomWidth: 1,
    borderBottomColor: '#E5E7EB',
    height: 48,
  },
  suggestionText: {
    fontSize: 16,
    color: '#333',
  },
  errorText: {
    color: '#ff4d4d',
    fontSize: 12,
    marginTop: 4,
  },
});

export default React.memo(AutocompleteInput);


import React, { useState, useEffect, useCallback } from 'react';
import { View, TouchableOpacity, StyleSheet, Text, Alert, ActivityIndicator } from 'react-native';
import axios from 'axios';
import * as Location from 'expo-location';
import AutocompleteInput from '../AutocompleteInput';
import { LinearGradient } from 'expo-linear-gradient';

export default function GeolocationSearch({ onSearch }) {
  const [searchQuery, setSearchQuery] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);

  const handleSearch = useCallback(async (query) => {
    setLoading(true);
    setError(null);
    try {
      const { status } = await Location.requestForegroundPermissionsAsync();
      if (status !== 'granted') {
        setError('Location permission denied');
        return;
      }

      const location = await Location.getCurrentPositionAsync({ accuracy: Location.Accuracy.High });
      const { latitude, longitude } = location.coords;

      const response = await axios.get('https://retail-alvinia-goza-f6a0e4f7.koyeb.app/shop-product-search/', {
        params: { input: query, lat: latitude, lon: longitude },
      });

      if (response.data.error) {
        Alert.alert('Error', response.data.error);
        return;
      }

      if (response.data.shops.length === 0) {
        Alert.alert('No Results', 'No shops found for your search.');
      }

      onSearch(response.data.shops);
    } catch (err) {
      setError('Error fetching data. Please check your connection.');
      console.error(err);
    } finally {
      setLoading(false);
    }
  }, [onSearch]);

  return (
    <LinearGradient colors={['#E3F2FD', '#BBDEFB']} style={styles.container}>
      <View style={styles.card}>
        {error && <Text style={styles.error}>{error}</Text>}
        <AutocompleteInput
          value={searchQuery}
          onChangeText={setSearchQuery}
          onSubmit={handleSearch}
          style={styles.input}
        />
        <TouchableOpacity
          style={[styles.searchButton, loading && styles.searchButtonDisabled]}
          onPress={() => handleSearch(searchQuery)}
          disabled={loading}
          activeOpacity={0.8}
        >
          {loading ? (
            <ActivityIndicator size="small" color="#fff" />
          ) : (
            <Text style={styles.searchButtonText}>Search</Text>
          )}
        </TouchableOpacity>
      </View>
    </LinearGradient>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    padding: 16,
    alignItems: 'center',
    justifyContent: 'center',
  },
  card: {
    backgroundColor: '#fff',
    borderRadius: 12,
    padding: 20,
    width: '100%',
    maxWidth: 400,
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.1,
    shadowRadius: 5,
    elevation: 4,
  },
  input: {
    marginBottom: 12,
  },
  searchButton: {
    backgroundColor: '#007bff',
    paddingVertical: 12,
    borderRadius: 8,
    alignItems: 'center',
  },
  searchButtonDisabled: {
    backgroundColor: '#A7C7E7',
  },
  searchButtonText: {
    color: '#fff',
    fontSize: 16,
    fontWeight: 'bold',
  },
  error: {
    color: 'red',
    fontSize: 12,
    marginBottom: 8,
    textAlign: 'center',
  },
});




import React, { useState } from 'react';
import { View, TouchableOpacity, StyleSheet, Text, Animated } from 'react-native';
import { useRouter, usePathname } from 'expo-router';
import GeolocationSearch from './GeolocationSearch';
import LocationSearch from './LocationSearch';
import ShopIdSearch from './ShopIdSearch';
import { LinearGradient } from "expo-linear-gradient";

export default function ShopSearchComponent() {
  const [activeFilter, setActiveFilter] = useState('geolocation');
  const [fadeAnim] = useState(new Animated.Value(1));
  const router = useRouter();
  const pathname = usePathname();

  const handleSearch = (searchData) => {
    if (router) {
      router.push({
        pathname: '/shop/SearchResult',
        params: { searchResults: JSON.stringify(searchData), prevRoute: pathname },
      });
    }
  };

  const switchFilter = (filter) => {
    if (filter !== activeFilter) {
      Animated.sequence([
        Animated.timing(fadeAnim, { toValue: 0, duration: 150, useNativeDriver: true }),
        Animated.timing(fadeAnim, { toValue: 1, duration: 200, useNativeDriver: true }),
      ]).start();
      setActiveFilter(filter);
    }
  };

  return (
    <LinearGradient colors={["#E3F2FD", "#BBDEFB"]} style={[styles.container, { overflow: 'visible' }]}>
      <View style={styles.filterContainer}>
        {['geolocation', 'location', 'Space ID'].map((filter) => (
          <TouchableOpacity
            key={filter}
            style={[styles.filterButton, activeFilter === filter && styles.activeFilter]}
            onPress={() => switchFilter(filter)}
          >
            <Text style={[styles.filterText, activeFilter === filter && styles.activeFilterText]}>
              {filter.charAt(0).toUpperCase() + filter.slice(1)}
            </Text>
          </TouchableOpacity>
        ))}
      </View>

      <Animated.View style={[styles.searchContainer, { opacity: fadeAnim, overflow: 'visible' }]}>
        {activeFilter === 'geolocation' && <GeolocationSearch onSearch={handleSearch} />}
        {activeFilter === 'location' && <LocationSearch onSearch={handleSearch} />}
        {activeFilter === 'shop ID' && <ShopIdSearch onSearch={handleSearch} />}
      </Animated.View>
    </LinearGradient>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    padding: 20,
    overflow: 'visible',
  },
  filterContainer: {
