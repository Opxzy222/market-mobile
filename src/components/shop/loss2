      EnterOtp: "enter-otp",
      notFound: "*",
    },
  },
};

const MemoizedTabs = memo(Tabs);

const RootLayout = () => {
  const [userId, setUserId] = useState<number | null>(null);
  const [unreadCount, setUnreadCount] = useState<number>(0);
  const [socket, setSocket] = useState<WebSocket | null>(null);
  const insets = useSafeAreaInsets();
  const reconnectAttemptsRef = useRef(0);
  const maxReconnectAttempts = 5;
  const lastUnreadCountRef = useRef(0);
  const pathname = usePathname();

  // Debug logging for pathname and tab state
  if (__DEV__) {
    console.log("RootLayout rendered", { pathname });
  }

  // Shop is active (shows "Home") on /, /tabs/shop, or /shop/*
  const isShopActive = pathname === "/" || pathname === "" || pathname === "/index" || pathname === "/tabs/shop" || pathname.startsWith("/shop/");

  useEffect(() => {
    const fetchUserId = async () => {
      try {
        const userIdString = await AsyncStorage.getItem("user_id");
        if (userIdString) {
          const parsedId = parseInt(userIdString, 10);
          if (!isNaN(parsedId)) {
            setUserId(parsedId);
          }
        }
      } catch (error) {
        console.error("Error fetching user ID:", error);
      }
    };
    fetchUserId();
  }, []);

  const setupWebSocket = useCallback(() => {
    if (!userId || reconnectAttemptsRef.current >= maxReconnectAttempts) {
      if (__DEV__) {
        console.log("Skipping WebSocket: no userId or max reconnects reached");
      }
      return;
    }

    const ws = new WebSocket(
      `wss://retail-alvinia-goza-f6a0e4f7.koyeb.app/ws/unread-messages/?userId=${userId}`
    );

    ws.onopen = () => {
      if (__DEV__) {
        console.log("WebSocket connected");
      }
      reconnectAttemptsRef.current = 0;
      ws.send(JSON.stringify({ action: "get_unread_count" }));
    };

    ws.onmessage = (event) => {
      const data = JSON.parse(event.data);
      if (data.unread_count !== undefined && data.unread_count !== lastUnreadCountRef.current) {
        lastUnreadCountRef.current = data.unread_count;
        if (__DEV__) {
          console.log("Updating unread count:", data.unread_count);
        }
        setUnreadCount(data.unread_count);
      }
    };

    ws.onerror = (error) => {
      console.error("WebSocket error:", error);
    };

    ws.onclose = () => {
      if (__DEV__) {
        console.log("WebSocket closed");
      }
      if (reconnectAttemptsRef.current < maxReconnectAttempts) {
        reconnectAttemptsRef.current += 1;
        if (__DEV__) {
          console.log(`Reconnecting WebSocket (attempt ${reconnectAttemptsRef.current})`);
        }
        setTimeout(setupWebSocket, 10000);
      } else {
        if (__DEV__) {
          console.log("Max WebSocket reconnect attempts reached");
        }
      }
    };

    setSocket(ws);

    return () => {
      ws.close();
    };
  }, [userId]);

  useEffect(() => {
    if (userId) {
      return setupWebSocket();
    }
  }, [userId, setupWebSocket]);

  const tabOptions = useMemo(
    () => ({
      headerShown: false,
      tabBarShowLabel: true,
      tabBarStyle: {
        backgroundColor: "#E3F2FD",
        borderTopWidth: 0,
        elevation: 10,
        height: 60 + (Platform.OS === "android" ? insets.bottom : 0),
        paddingBottom: Platform.OS === "android" ? insets.bottom : 0,
        display: "flex",
      },
      tabBarLabelStyle: {
        fontSize: 12,
        fontWeight: "600",
        marginBottom: 5,
        width: 70,
      },
      tabBarItemStyle: {
        justifyContent: "center",
        alignItems: "center",
      },
      tabBarActiveTintColor: "#007AFF",
      tabBarInactiveTintColor: "#000000",
      tabBarLabelPosition: "below-icon",
    }),
    [insets.bottom]
  );

  return (
    <GestureHandlerRootView style={styles.container}>
      <SafeAreaProvider>
        <SelectProvider>
          <SubscriptionProvider userId={userId}>
            <MemoizedTabs screenOptions={tabOptions} initialRouteName="index">
              <Tabs.Screen
                name="index"
                options={{
                  href: null,
                }}
              />
              <Tabs.Screen
                name="(tabs)/shop"
                options={{
                  title: isShopActive ? "Shop" : "Home",
                  tabBarIcon: ({ color }) => (
                    <Ionicons name={isShopActive ? "search-outline" : "home-outline"} color={color} size={22} />
                  ),
                  href: isShopActive ? "/tabs/shop" : "/",
                }}
              />
              <Tabs.Screen
                name="(tabs)/messages"
                options={{
                  title: "Messages",
                  tabBarIcon: ({ color }) => <MaterialIcons name="message" color={color} size={22} />,
                  tabBarBadge: unreadCount > 0 ? unreadCount : null,
                  href: "/tabs/messages",
                }}
              />
              <Tabs.Screen
                name="(tabs)/status"
                options={{
                  title: "Status",
                  tabBarIcon: ({ color }) => <Ionicons name="time-outline" color={color} size={22} />,
                  href: "/tabs/status",
                }}
              />
              <Tabs.Screen
                name="(tabs)/myshop"
                options={{
                  title: "My Space",
                  tabBarIcon: ({ color }) => <FontAwesome5 name="store" color={color} size={22} />,
                  href: "/tabs/myshop",
                }}
              />
              <Tabs.Screen
                name="(tabs)/account"
                options={{
                  title: "Account",
                  tabBarIcon: ({ color }) => <Ionicons name="card-outline" color={color} size={22} />,
                  href: "/tabs/account",
                }}
              />
              <Tabs.Screen
                name="(tabs)/profile"
                options={{
                  title: "Profile",
                  tabBarIcon: ({ color }) => <Ionicons name="person-circle-outline" color={color} size={22} />,
                  href: "/tabs/profile",
                }}
              />
              {/* Non-tab screens */}
              <Tabs.Screen name="shop/Conversation" options={{ href: null }} />
              <Tabs.Screen name="shop/ShopProfile" options={{ href: null }} />
              <Tabs.Screen name="shop/AdminShopPage" options={{ href: null }} />
              <Tabs.Screen name="shop/AllCategories" options={{ href: null }} />
              <Tabs.Screen name="shop/AllFollowedShops" options={{ href: null }} />
              <Tabs.Screen name="shop/AllRecentShops" options={{ href: null }} />
              <Tabs.Screen name="shop/ChildCategoryList" options={{ href: null }} />
              <Tabs.Screen name="shop/CreateShop" options={{ href: null }} />
              <Tabs.Screen name="shop/CustomerReceipts" options={{ href: null }} />
              <Tabs.Screen name="shop/Details" options={{ href: null }} />
              <Tabs.Screen name="shop/EditProfile" options={{ href: null }} />
              <Tabs.Screen name="shop/GenerateReceipt" options={{ href: null }} />
              <Tabs.Screen name="shop/MessageList" options={{ href: null }} />
              <Tabs.Screen name="shop/ReceiptActions" options={{ href: null }} />
              <Tabs.Screen name="shop/SearchResult" options={{ href: null }} />
              <Tabs.Screen name="shop/ShopProduct" options={{ href: null }} />
              <Tabs.Screen name="shop/ShopReceipts" options={{ href: null }} />
              <Tabs.Screen name="shop/ShopStatus" options={{ href: null }} />
              <Tabs.Screen name="shop/Signature" options={{ href: null }} />
              <Tabs.Screen name="shop/StartConversation" options={{ href: null }} />
              <Tabs.Screen name="shop/SubcategoryList" options={{ href: null }} />
              <Tabs.Screen name="shop/Subscription" options={{ href: null }} />
              <Tabs.Screen name="shop/UpdateProduct" options={{ href: null }} />
              <Tabs.Screen name="shop/WelcomeWorkingHours" options={{ href: null }} />
              <Tabs.Screen name="shop/WorkingHours" options={{ href: null }} />
              <Tabs.Screen name="shop/shop-page" options={{ href: null }} />
              <Tabs.Screen name="homepage" options={{ href: null }} />
              <Tabs.Screen name="shop" options={{ href: null }} />
              <Tabs.Screen name="login" options={{ href: null, tabBarStyle: { display: "none" } }} />
              <Tabs.Screen name="signup" options={{ href: null, tabBarStyle: { display: "none" } }} />
              <Tabs.Screen name="ChangePassword" options={{ href: null, tabBarStyle: { display: "none" } }} />
              <Tabs.Screen name="RequestToken" options={{ href: null, tabBarStyle: { display: "none" } }} />
              <Tabs.Screen name="ResetPassword" options={{ href: null, tabBarStyle: { display: "none" } }} />
              <Tabs.Screen name="VerifyEmail" options={{ href: null, tabBarStyle: { display: "none" } }} />
              <Tabs.Screen name="ForgotPassword" options={{ href: null, tabBarStyle: { display: "none" } }} />
              <Tabs.Screen name="EnterOtp" options={{ href: null, tabBarStyle: { display: "none" } }} />
              <Tabs.Screen name="+not-found" options={{ href: null, tabBarStyle: { display: "none" } }} />
            </MemoizedTabs>
          </SubscriptionProvider>
        </SelectProvider>
      </SafeAreaProvider>
    </GestureHandlerRootView>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
  },
});

export default memo(RootLayout);