  prefixes: [Linking.createURL("/")],
  config: {
    screens: {
      index: "",
      "(tabs)": {
        path: "tabs",
        screens: {
          shop: "shop",
          placeholder: "messages",
          status: "status",
          myshop: "myshop",
          account: "account",
