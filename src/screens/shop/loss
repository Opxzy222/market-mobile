class Location(models.Model):
    name = models.CharField(max_length=255)
    parent = models.ForeignKey(
        "self", on_delete=models.CASCADE, null=True, blank=True, related_name="children"
    )
    level = models.CharField(
        max_length=50,
        choices=[("state", "State"), ("lga", "LGA"), ("location", "Location")],
    )
    suffix = models.CharField(max_length=10, unique=True, null=True, blank=True)  # Unique suffix

    def save(self, *args, **kwargs):
        if not self.suffix:
            self.suffix = self.generate_suffix()
        super().save(*args, **kwargs)

    def generate_suffix(self):
        if self.level == "state":
            # Generate state suffix (A-Z, then AA-ZZ for more states)
            state_count = Location.objects.filter(level="state").count()
            if state_count < 26:
                return chr(65 + state_count)  # A-Z
            else:
                first_letter = chr(65 + (state_count // 26) - 1)  # AA, AB, etc.
                second_letter = chr(65 + (state_count % 26))
                return f"{first_letter}{second_letter}"

        elif self.level == "lga":
            # Generate LGA suffix based on parent (state)
            siblings = Location.objects.filter(parent=self.parent, level="lga")
            return f"{self.parent.suffix}{len(siblings) + 1:02d}"  # E.g., A01, A02

        elif self.level == "location":
            # Generate location suffix based on parent (LGA)
            siblings = Location.objects.filter(parent=self.parent, level="location")
            return f"{self.parent.suffix}{len(siblings) + 1:02d}"  # E.g., A0101

        return None

    def __str__(self):
        return self.name

