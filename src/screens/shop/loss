class Receipt(models.Model):
    class StatusChoices(models.TextChoices):
        PENDING = "pending", _("Pending")
        ACCEPTED = "accepted", _("Accepted")
        REJECTED = "rejected", _("Rejected")
        VOIDED = "voided", _("Voided")

    shop = models.ForeignKey(Shop, on_delete=models.CASCADE, related_name="receipts")
    customer = models.ForeignKey(User, on_delete=models.SET_NULL, null=True, blank=True, related_name="receipts")
    customer_user_id = models.CharField(max_length=8, null=True, blank=True)
    customer_name = models.CharField(max_length=255)
    receipt_id = models.CharField(max_length=9, unique=True, editable=False)
    items = models.JSONField()
    total_amount = models.DecimalField(max_digits=10, decimal_places=2)
    status = models.CharField(
        max_length=10, choices=StatusChoices.choices, default=StatusChoices.PENDING
    )
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    pdf_file = models.FileField(
        upload_to='receipts/',
        storage=B2Storage(),
        null=True,
        blank=True
    )  # Store PDF in Backblaze
    image_urls = models.JSONField(default=list, blank=True)  # Store signed image URLs

    def accept(self):
        """Mark the receipt as accepted by the customer."""
        if self.status == self.StatusChoices.PENDING:
            self.status = self.StatusChoices.ACCEPTED
            self.save()

    def reject(self):
        """Mark the receipt as rejected by the customer."""
        if self.status == self.StatusChoices.PENDING:
            self.status = self.StatusChoices.REJECTED
            self.save()

    def void(self):
        """Allow the seller to void the receipt if it has not been accepted."""
        if self.status == self.StatusChoices.PENDING:
            self.status = self.StatusChoices.VOIDED
            self.save()

    def generate_receipt_id(self):
        while True:
            new_id = str(random.randint(10**6, 10**9 - 1))  # Generates a 7 to 9 digit ID
            if not Receipt.objects.filter(receipt_id=new_id).exists():
                return new_id

    def save(self, *args, **kwargs):
        if self.pk:  # Only for updates
            try:
                old_instance = Receipt.objects.get(pk=self.pk)
                self._state_before_update = {'status': old_instance.status}
                # Delete old PDF if updated
                if old_instance.pdf_file and self.pdf_file != old_instance.pdf_file:
                    try:
                        old_instance.pdf_file.delete()
                    except Exception as e:
                        logger.error(f"Failed to delete old PDF {old_instance.pdf_file.name}: {str(e)}")
            except Receipt.DoesNotExist:
                self._state_before_update = {}
        else:
            self._state_before_update = {}
        if not self.receipt_id:
            self.receipt_id = self.generate_receipt_id()
        if self.customer:
            self.customer_user_id = self.customer.user_id
        super().save(*args, **kwargs)

