class SubscriptionPlan(models.TextChoices):
    FREE = 'free', 'Free'
    REGULAR = 'regular', 'Regular'
    STANDARD = 'standard', 'Standard'
    PREMIUM = 'premium', 'Premium'

class Subscription(models.Model):
    user = models.OneToOneField(User, on_delete=models.CASCADE, related_name="subscription")
    plan = models.CharField(max_length=10, choices=SubscriptionPlan.choices, default=SubscriptionPlan.FREE)
    start_date = models.DateTimeField(auto_now_add=True)
    end_date = models.DateTimeField(null=True, blank=True)
    last_plan = models.CharField(max_length=10, choices=SubscriptionPlan.choices, null=True, blank=True)  # Store last paid plan

    def is_active(self):
        """Check if subscription is active, revert to FREE if expired"""
        if self.plan == SubscriptionPlan.FREE:
            return True
        if self.end_date and self.end_date <= timezone.now():
            self.last_plan = self.plan  # Store the expired plan
            self.plan = SubscriptionPlan.FREE
            self.end_date = None
            self.save()
            return False
        return True

    def upgrade_plan(self, new_plan, duration_days=30):
        """Upgrade user plan and set expiration for paid plans"""
        if new_plan != SubscriptionPlan.FREE:
            self.last_plan = self.plan if self.plan != SubscriptionPlan.FREE else self.last_plan  # Store current plan if not FREE
            self.plan = new_plan
            self.end_date = timezone.now() + timedelta(days=duration_days)
        else:
            self.plan = new_plan
            self.end_date = None
        self.save()

    @staticmethod
    def renew_last_plan(user_id, duration_days=30):
        """Renew the last paid subscription plan for a user by user_id"""
        try:
            user = User.objects.get(user_id=user_id)  # Fetch user by user_id
            subscription, created = Subscription.objects.get_or_create(user=user)
            if subscription.last_plan and subscription.last_plan != SubscriptionPlan.FREE:
                subscription.plan = subscription.last_plan
                subscription.end_date = timezone.now() + timedelta(days=duration_days)
                subscription.save()
                return f"Subscription renewed: {user.firstname} is now on {subscription.plan} plan."
            return "No previous paid plan to renew."
        except User.DoesNotExist:
            return "User not found."
        except Exception as e:
            return f"Error: {str(e)}"

    @staticmethod
    def get_users_by_plan(plan):
        """Returns a list of User IDs for a given plan"""
        return list(Subscription.objects.filter(plan=plan).values_list("user_id", flat=True))

    @staticmethod
    def get_regular_users():
        """Returns User IDs of users with Regular plan"""
        return Subscription.get_users_by_plan(SubscriptionPlan.REGULAR)

    @staticmethod
    def get_standard_users():
        """Returns User IDs of users with Standard plan"""
        return Subscription.get_users_by_plan(SubscriptionPlan.STANDARD)

    @staticmethod
    def set_user_subscription(user_id, new_plan, duration_days=30):
        """Manually set a user's subscription plan"""
        try:
            user = User.objects.get(user_id=user_id)
            subscription, created = Subscription.objects.get_or_create(user=user)
            subscription.upgrade_plan(new_plan, duration_days)
            return f"Subscription updated: {user.firstname} is now on {new_plan} plan."
        except User.DoesNotExist:
            return "User not found."
        except Exception as e:
            return f"Error: {str(e)}"

    @staticmethod
    def check_expired_subscriptions():
        """Check and revert expired subscriptions to FREE"""
        expired_subscriptions = Subscription.objects.filter(
            plan__in=[SubscriptionPlan.REGULAR, SubscriptionPlan.STANDARD, SubscriptionPlan.PREMIUM],
            end_date__lte=timezone.now()
        )
        for subscription in expired_subscriptions:
            subscription.last_plan = subscription.plan
            subscription.plan = SubscriptionPlan.FREE
            subscription.end_date = None
            subscription.save()

