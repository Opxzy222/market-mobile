def clean_and_generate_url(file_obj, path_prefix):
    """Clean and generate a Backblaze B2 URL for a file object."""
    if not file_obj or not file_obj.name:
        return None
    
    file_name = file_obj.name
    # Handle malformed URLs (e.g., stored signed URLs)
    if file_name.startswith('https://'):
        match = re.search(rf'(?:{path_prefix}|statuses|statuses/thumbnails)/[^?]+', file_name)
        file_name = match.group(0) if match else None
        logger.debug(f"Cleaned file path from URL: {file_name}")
    
    # Handle legacy statuses/ or statuses/thumbnails/ paths
    if file_name and (file_name.startswith('statuses/')):
        file_extension = file_name.split('.')[-1].lower()
        status_id = getattr(file_obj, 'status_id', 0) if hasattr(file_obj, 'status_id') else 0
        prefix = 'post_attachments' if not file_name.startswith('statuses/thumbnails/') else 'post_thumbnails'
        new_file_name = f"{prefix}/{status_id}/{uuid.uuid4()}.{file_extension}"
        if default_storage.exists(file_name):
            with default_storage.open(file_name, 'rb') as source_file:
                default_storage.save(new_file_name, source_file)
            file_name = new_file_name
            logger.info(f"Copied legacy file from {file_name} to {new_file_name}")
        else:
            logger.warning(f"Legacy file not found: {file_name}")
    
    if file_name:
        try:
            url = default_storage.url(file_name)
            logger.debug(f"Generated URL: {url}")
            return url
        except Exception as e:
            logger.error(f"Failed to generate URL for {file_name}: {str(e)}", exc_info=True)
    
    return None

def get_status_upload_path(instance, filename):
    return f"post_attachments/{instance.id}/{filename}"

def get_thumbnail_upload_path(instance, filename):
    return f"post_thumbnails/{instance.id}/{filename}"

class Status(models.Model):
    shop = models.ForeignKey('Shop', on_delete=models.CASCADE, related_name="statuses")
    media = models.FileField(upload_to=get_status_upload_path, null=True, blank=True)
    media_type = models.CharField(
        max_length=10, 
        choices=[('image', 'Image'), ('video', 'Video'), ('text', 'Text')],
        default='text'
    )
    text = models.TextField(null=True, blank=True)
    created_at = models.DateTimeField(auto_now_add=True)
    thumbnail = models.ImageField(upload_to=get_thumbnail_upload_path, null=True, blank=True)

    class Meta:
        ordering = ["-created_at"]

    def is_expired(self):
        """Check if the status is older than 24 hours"""
        return self.created_at < timezone.now() - timedelta(hours=24)

    def delete(self, *args, **kwargs):
        """Delete media and thumbnail files from storage when the status is deleted"""
        try:
            if self.media and self.media.name:
                if default_storage.exists(self.media.name):
                    default_storage.delete(self.media.name)
                    logger.info(f"Deleted media file: {self.media.name}")
                else:
                    logger.warning(f"Media file not found: {self.media.name}")
            
            if self.thumbnail and self.thumbnail.name:
                if default_storage.exists(self.thumbnail.name):
                    default_storage.delete(self.thumbnail.name)
                    logger.info(f"Deleted thumbnail file: {self.thumbnail.name}")
                else:
                    logger.warning(f"Thumbnail file not found: {self.thumbnail.name}")
        except Exception as e:
            logger.error(f"Error deleting files for status ID {self.id}: {str(e)}", exc_info=True)
        
        logger.debug(f"Calling models.Model.delete for status ID: {self.id}")
        super().delete(*args, **kwargs)

    def __str__(self):
        return f"Status from {self.shop.name} at {self.created_at}"

    def get_thumbnail_url(self):
        if self.thumbnail:
            return clean_and_generate_url(self.thumbnail, 'post_thumbnails')
        elif self.media_type == 'image' and self.media:
            return clean_and_generate_url(self.media, 'post_attachments')
        return None
    
