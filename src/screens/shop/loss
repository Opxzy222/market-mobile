    is_phone_verified = models.BooleanField(default=False)  # Tracks phone number verification
    phone_verification_token = models.CharField(max_length=6, null=True, blank=True)  # Stores OTP
    phone_verification_expires_at = models.DateTimeField(null=True, blank=True)  # OTP expiration

    def save(self, *args, **kwargs):
        if not self.user_id:  # Generate only if it's a new user
            self.user_id = self.generate_unique_user_id()
        super().save(*args, **kwargs)

    def generate_unique_user_id(self):
        while True:
            random_id = str(random.randint(10000000, 99999999))  # Generate a 6-digit number
            if not User.objects.filter(user_id=random_id).exists():
                return random_id

    def generate_email_verification_token(self):
        self.email_verification_token = str(random.randint(100000, 999999))
        self.save()

        # Assuming you're also storing this in the PendingUser model, create the pending user
        pending_user = PendingUser.objects.create(
            email=self.email,
            verification_token=self.email_verification_token,
        )

    def verify_user(self):
        """Set user as verified."""
        self.is_verified = True
        self.save()

    @staticmethod
    def set_user_verified(user_id):
        """Static method to verify a user by user_id."""
        user = User.objects.filter(user_id=user_id).first()
        if user:
            user.is_verified = True
            user.save()
            return True
        return False

    def delete(self, *args, **kwargs):
        self.is_active = False
        self.save()

    @property
    def fullname(self):
        # Ensure the first letter of each name is capitalized
        return f'{self.firstname} {self.lastname}'.title()

    @property
    def is_authenticated(self):
        """ Required by Django’s authentication system """
        return True  # Since this is a valid user, always return True

    def __str__(self):
        # name representation of the class
        return self.fullname

