@receiver(post_save, sender=Message)
def notify_unread_messages(sender, instance, created, **kwargs):
    if created:
        receiver = instance.receiver
        cache_key = f"unread_count_{receiver.id}"
        
        # Calculate unread count for receiver
        new_unread_count = Message.objects.filter(
            receiver=receiver,
            read=False
        ).values("conversation_id").distinct().count()
        
        logger.info(f"New unread message for user {receiver.id} from sender {instance.sender.id}. New unread count: {new_unread_count}")

        # Update cache
        cache.set(cache_key, new_unread_count, timeout=300)

        # Send WebSocket notification to receiver's group
        channel_layer = get_channel_layer()
        async_to_sync(channel_layer.group_send)(
            f"user_{receiver.id}_unread_messages",
            {
                "type": "unread_message_notification",
                "unread_count": new_unread_count,
            }
        )


