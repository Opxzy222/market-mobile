        upload_to='receipts/signatures/',
        storage=B2Storage(),
        max_length=200,
        null=True,
        blank=True
    )
    is_24_7 = models.BooleanField(default=False)
    is_active = models.BooleanField(default=True)  # Soft deletion flag
    deletion_requested_at = models.DateTimeField(null=True, blank=True)
    
    # New fields
    lga = models.ForeignKey(Location, on_delete=models.CASCADE, null=True, related_name="lga_shops")  # Reference to the LGA
    shop_id = models.CharField(max_length=7, unique=True, null=True, blank=True)  # Unique 7-digit Shop ID

    objects = ShopManager()  # Default manager filters active shops
    all_objects = models.Manager()  # Access all shops, including soft-deleted

    def save(self, *args, **kwargs):
        if not self.shop_id:
            self.shop_id = self.generate_shop_id()
            super().save(*args, **kwargs)  # Save Shop first to get an ID
            ShopIdHistory.objects.create(shop_id=self.shop_id, related_shop=self)  # Now create history
        else:
            super().save(*args, **kwargs)

    def delete(self, *args, **kwargs):
        """Soft delete: mark as inactive and set deletion request time."""
        self.is_active = False
        self.deletion_requested_at = timezone.now()
        if self.shop_id:
            history = ShopIdHistory.objects.get(shop_id=self.shop_id)
            history.deleted_at = timezone.now()
            history.save()
        self.save()


    def generate_shop_id(self):
        """
        Generate a unique 7-digit shop ID based on the LGA, using the suffix and random numbers.
        """
        if not self.lga or not self.lga.suffix:
            logger.error(f"LGA is missing or has no valid suffix: {self.lga}")
            raise ValueError("LGA must have a valid suffix to generate a shop ID.")

        base_suffix = str(self.lga.suffix).strip()  # Ensure it's a string and remove spaces

        if len(base_suffix) > 3:
            logger.warning(f"LGA suffix '{base_suffix}' is too long. Trimming to 3 characters.")
            base_suffix = base_suffix[:3]  # Trim to 3 characters max

        if len(base_suffix) < 2:
            logger.error(f"LGA suffix '{base_suffix}' is too short!")
            raise ValueError("LGA suffix must be at least 2 characters.")

        max_attempts = 50  # Allow more attempts before failing

        for _ in range(max_attempts):
            random_digits = random.randint(1000, 9999)  # Always 4 digits
            shop_id = f"{base_suffix}{random_digits}"

            if len(shop_id) == 7 and not ShopIdHistory.objects.filter(shop_id=shop_id).exists():
                return shop_id

        logger.error(f"Failed to generate unique Shop ID for LGA {self.lga} after {max_attempts} attempts.")
        raise ValueError("Failed to generate a unique Shop ID after multiple attempts.")

    def __str__(self):
        return self.name

    def average_rating(self):
        latest_reviews = Review.objects.filter(
            id__in=Subquery(
                Review.objects.filter(shop=self)
                .order_by("reviewer", "-created_at")
                .distinct("reviewer")
                .values("id")
            )
        )
        if not latest_reviews.exists():
            return None
        avg = latest_reviews.aggregate(avg_rating=Avg("rating"))["avg_rating"]
        return round(avg, 1) if avg is not None else None

    def is_open_now(self):
        """Check if the shop is currently open based on working hours."""
        now = localtime()  # Ensures timezone consistency
        today = now.strftime('%A').lower()  # 'monday', 'tuesday', etc.

        working_hours = getattr(self, "working_hours", None)
        if not working_hours:
            return False

        if working_hours.is_24_7:
            return True

        if getattr(working_hours, f"{today}_closed", False):
            return False

        open_time = getattr(working_hours, f"{today}_open", None)
        close_time = getattr(working_hours, f"{today}_close", None)

        if not open_time or not close_time:
            return False

        current_time = now.time()
        return open_time <= current_time <= close_time
    
