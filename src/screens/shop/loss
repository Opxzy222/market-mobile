import { useState, useEffect, useMemo } from "react";
import {
  View,
  Text,
  StyleSheet,
  FlatList,
  TouchableOpacity,
  Image,
  Dimensions,
  SafeAreaView,
  StatusBar,
  Modal, TouchableWithoutFeedback, KeyboardAvoidingView,
  Keyboard
} from 'react-native';
import { useRouter, useLocalSearchParams } from 'expo-router';
import { MaterialIcons } from '@expo/vector-icons';
import { LinearGradient } from "expo-linear-gradient";
import Slider from "@react-native-community/slider";
import Ionicons from "react-native-vector-icons/Ionicons";

const screenWidth = Dimensions.get("window").width;

export default function SearchResults() {
  const params = useLocalSearchParams();
  const { prevRoute } = params;
  const searchResults = useMemo(
    () => (params.searchResults ? JSON.parse(params.searchResults) : []),
    [params.searchResults]
  );

  const router = useRouter();
  const [minRating, setMinRating] = useState(0);
  const [maxRating, setMaxRating] = useState(5);
  const [minDistance, setMinDistance] = useState(0);
  const [maxDistance, setMaxDistance] = useState(50);
  const [filteredResults, setFilteredResults] = useState(searchResults);
  const [modalVisible, setModalVisible] = useState(false);

  const allDistancesNull = useMemo(
    () => searchResults.every((shop) => shop.distance === null),
    [searchResults]
  );

  useEffect(() => {
  setMinRating(0);
  setMaxRating(5);
  setMinDistance(0);
  setMaxDistance(50);
  setFilteredResults(searchResults);
}, [searchResults]);


  const applyFilters = () => {
    const results = searchResults.filter((shop) => {
      let ratingCheck = shop.average_rating >= minRating && shop.average_rating <= maxRating;
      let distanceCheck = true;

      if (!allDistancesNull && shop.distance !== null) {
        distanceCheck = shop.distance >= minDistance && shop.distance <= maxDistance;
      }
      return ratingCheck && distanceCheck;
    });
    setFilteredResults(results);
  };

  useEffect(() => {
    applyFilters();
  }, [minRating, maxRating, minDistance, maxDistance]);

  const renderShopCard = ({ item }) => (
    <LinearGradient colors={["rgba(255,255,255,0.6)", "rgba(240,240,240,0.4)"]} style={styles.shopCard}>
      <View style={styles.imageContainer}>
        {item.average_rating !== null && (
          <View style={styles.ratingBadge}>
            <MaterialIcons name="star" size={14} color="#FFD700" />
            <Text style={styles.ratingText}>{item.average_rating}</Text>
          </View>
        )}
        {item.image ? (
          <Image source={{ uri: `https://127.0.0.1:8000/${item.image}` }} style={styles.shopImage} />
        ) : (
          <View style={styles.noImageContainer}>
            <Text style={styles.noImageText}>No Image</Text>
          </View>
        )}
      </View>
      <View style={styles.detailsContainer}>
        <Text style={styles.shopName}>{item.name || "Unnamed Shop"}</Text>
        <View style={styles.row}>
          <MaterialIcons name="store" size={18} color="#4CAF50" />
          <Text style={styles.shopAddress}>{item.address || "No Address"}</Text>
        </View>
        <View style={styles.row}>
          <MaterialIcons name="place" size={18} color="#555" />
          <Text style={styles.shopDistance}>Distance: {item.distance ?? "N/A"} km</Text>
        </View>
      </View>
    </LinearGradient>
  );

  return (
  <SafeAreaView style={styles.safeArea}>
    <StatusBar barStyle="dark-content" />
    <LinearGradient colors={["#F5F5F5", "#E0E0E0"]} style={styles.container}>
      
      {/* Header */}
      <View style={styles.header}>
        <TouchableOpacity onPress={() => router.back()} style={styles.backButton}>
          <MaterialIcons name="arrow-back" size={24} color="#007BFF" />
        </TouchableOpacity>
        <Text style={styles.headerTitle}>Search Results</Text>
      </View>

      {/* Filter Button */}
      <TouchableOpacity onPress={() => setModalVisible(true)} style={styles.filterButton}>
  <LinearGradient colors={["#007BFF", "#0056b3"]} style={styles.buttonGradient}>
    <Ionicons name="filter-outline" size={20} color="#FFF" style={styles.buttonIcon} />
    <Text style={styles.filterButtonText}>Filter</Text>
  </LinearGradient>
</TouchableOpacity>


      {/* Shop List */}
      <FlatList
        data={filteredResults}
        keyExtractor={(item) => item.id.toString()}
        renderItem={renderShopCard}
        ListEmptyComponent={<Text style={styles.noResults}>No shops found.</Text>}
      />
    </LinearGradient>

    {/* Modal for Filters */}
    {/* Modal for Filters */}
{modalVisible && (
  <Modal visible={modalVisible} animationType="fade" transparent>
    <TouchableWithoutFeedback onPress={() => setModalVisible(false)}>
      <View style={styles.modalOverlay}>
        <KeyboardAvoidingView behavior="padding" style={styles.modalContainer}>
          <View style={styles.modalContent}>
            <Text style={styles.filterTitle}>Filter Options</Text>

            {/* Rating Sliders */}
            <View style={styles.sliderContainer}>
              <Text style={styles.sliderLabel}>Min Rating: {minRating.toFixed(1)}</Text>
              <Slider
                minimumValue={0}
                maximumValue={5}
                step={1}
                value={minRating}
                onValueChange={setMinRating}
                style={styles.slider}
                minimumTrackTintColor="#007BFF"
                maximumTrackTintColor="#D3D3D3"
                thumbTintColor="#007BFF"
              />
            </View>

            <View style={styles.sliderContainer}>
              <Text style={styles.sliderLabel}>Max Rating: {maxRating.toFixed(1)}</Text>
              <Slider
                minimumValue={0}
                maximumValue={5}
                step={1}
                value={maxRating}
                onValueChange={setMaxRating}
                style={styles.slider}
                minimumTrackTintColor="#007BFF"
                maximumTrackTintColor="#D3D3D3"
                thumbTintColor="#007BFF"
              />
            </View>

            {/* Distance Sliders */}
            {!allDistancesNull && (
              <>
                <View style={styles.sliderContainer}>
                  <Text style={styles.sliderLabel}>Min Distance: {minDistance.toFixed(1)} km</Text>
                  <Slider
  minimumValue={0}
  maximumValue={50}
  step={0.1}
  value={minDistance}
  onValueChange={setMinDistance}
  style={styles.slider}
  minimumTrackTintColor={allDistancesNull ? "#D3D3D3" : "#007BFF"}
  maximumTrackTintColor="#D3D3D3"
  thumbTintColor={allDistancesNull ? "#A9A9A9" : "#007BFF"}
  disabled={allDistancesNull}
/>

                </View>

                <View style={styles.sliderContainer}>
                  <Text style={styles.sliderLabel}>Max Distance: {maxDistance.toFixed(1)} km</Text>
                  <Slider
                    minimumValue={0}
                    maximumValue={50}
                    step={0.1}
                    value={maxDistance}
                    onValueChange={setMaxDistance}
                    style={styles.slider}
                    minimumTrackTintColor="#007BFF"
                    maximumTrackTintColor="#D3D3D3"
                    thumbTintColor="#007BFF"
                  />
                </View>
              </>
            )}

            {/* Apply Filters Button */}
            <TouchableOpacity onPress={() => setModalVisible(false)} style={styles.applyButton}>
              <Text style={styles.applyButtonText}>Apply Filters</Text>
            </TouchableOpacity>
          </View>
        </KeyboardAvoidingView>
      </View>
    </TouchableWithoutFeedback>
  </Modal>
    )}
  </SafeAreaView>
);

}


