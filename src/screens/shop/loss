{
  "expo": {
    "name": "Gogo Market",
    "slug": "gogo-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon2.png",
    "scheme": "gogo-mobile",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "53.0.0",
    "splash": {
      "image": "./assets/images/icon2.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.timeflies.gogomarket",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserNotificationsUsageDescription": "Allow this app to send you notifications about new followers, reviews, posts, and receipts.",
        "NSLocationWhenInUseUsageDescription": "Allow this app to use your location to find nearby shops.",
        "NSLocationAlwaysUsageDescription": "This app uses location services to provide a better experience.",
        "NSLocationUsageDescription": "This app uses location services to provide a better experience.",
        "NSMotionUsageDescription": "Allow this app to access motion data to estimate small movements.",
        "NSPhotoLibraryUsageDescription": "This app uses the photo library to provide a better experience.",
        "NSCameraUsageDescription": "This app uses the camera to provide a better experience.",
        "NSMicrophoneUsageDescription": "This app uses the microphone to provide a better experience.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon2.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.timeflies.gogomarket",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_PHONE_STATE",
        "android.permission.ACTIVITY_RECOGNITION",
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gogo-mobile",
              "host": "verification",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "buildProperties": {
        "android.enableR8.fullMode": true,
        "android.enableProguardInReleaseBuilds": true
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow this app to access your photos and videos to share them in chats."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "android": {
            "enableFTS": true
          },
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_FTS5=1 -DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      [
        "@react-native-firebase/app"
      ],
      [
        "@react-native-firebase/messaging"
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#ffffff",
          "androidMode": "default",
          "androidCollapsedTitle": "#{unread_notifications} new messages",
          "defaultChannel": "chat_channel",
          "sounds": [
            "./assets/sounds/chat_notification.mp3",
            "./assets/sounds/receipt_notification.mp3"
          ],
          "channels": [
            {
              "id": "chat_channel",
              "name": "Chat Notifications",
              "importance": "high",
              "sound": "chat_notification",
              "vibrationPattern": [
                100,
                200,
                300,
                400
              ],
              "enableVibrate": true
            },
            {
              "id": "receipt_channel",
              "name": "Receipt Notifications",
              "importance": "high",
              "sound": "receipt_notification",
              "vibrationPattern": [
                100,
                200,
                300,
                400
              ],
              "enableVibrate": true
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 24,
            "ndkVersion": "25.2.9519653",
            "enableHermes": false,
            "enableProguardInReleaseBuilds": true,
            "edgeToEdgeEnabled": true
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static",
            "extraPods": [
              {
                "name": "Realm",
                "version": "~> 10.52.2",
                "modular_headers": true
              },
              {
                "name": "DojahWidget",
                "git": "https://github.com/dojah-inc/sdk-swift.git",
                "branch": "pod-package"
              }
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow $(PRODUCT_NAME) to access your device motion"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2360241039001516~8918197768",
          "iosAppId": "ca-app-pub-2360241039001516~4122191720"
        }
      ],
      "./plugins/firebase-manifest-fix.js",
      "./plugins/withCustomNotificationChannel",
      "./plugins/withDependencyFix",
      "./plugins/withNoCameraPermission",
      "expo-mail-composer",
      "dojah-kyc-sdk-react-expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": [
      "**/*",
      "assets/sounds/**/*"
    ],
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/11a350ba-590c-4271-9e5a-a2ba71d36ffc",
      "comment": "Enables OTA updates to push new JavaScript bundles, including updated EXPO_PUBLIC_API_URL for switching API endpoints (e.g., from https://retail-alvinia-goza-f6a0e4f7.koyeb.app to https://api.gogo-digital.com) without rebuilding or resubmitting to app stores."
    },
    "runtimeVersion": {
      "policy": "sdkVersion",
      "value": "1.0.0"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64995cb6-43ec-4985-9b65-d4e2401f98e4"
      }
    },
    "owner": "timeflies"
  }
}
