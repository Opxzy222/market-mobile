import { useState, useEffect, useMemo, useCallback, useRef, useContext } from 'react';
import {
  View,
  Text,
  StyleSheet,
  FlatList,
  TouchableOpacity,
  Image,
  Dimensions,
  StatusBar,
  Modal,
  KeyboardAvoidingView,
  ActivityIndicator,
  Switch,
} from 'react-native';
import { useRouter, useLocalSearchParams, useFocusEffect } from 'expo-router';
import { MaterialIcons, Ionicons } from '@expo/vector-icons';
import { LinearGradient } from 'expo-linear-gradient';
import Slider from '@react-native-community/slider';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { useInterstitialAd } from '../../components/AdMobManager';
import { SubscriptionContext } from '../../components/SubscriptionProvider';
import SubscriptionRequired from '@/components/RequiredSubscription';
import { SafeAreaView } from 'react-native-safe-area-context';
import Animated, { FadeInUp, ZoomIn } from 'react-native-reanimated';

const screenWidth = Dimensions.get('window').width;

const SearchResults = () => {
  const params = useLocalSearchParams();
  const { subscriptionStatus, loading } = useContext(SubscriptionContext);
  const { showInterstitial, adLoaded } = useInterstitialAd();
  const router = useRouter();
  const [modalVisible, setModalVisible] = useState(false);
  const [subscriptionModalVisible, setSubscriptionModalVisible] = useState(false);
  const [showAd, setShowAd] = useState(false);

  const searchResults = useMemo(() => {
    try {
      return params.searchResults ? JSON.parse(params.searchResults) : [];
    } catch (error) {
      console.error('Error parsing searchResults:', error);
      return [];
    }
  }, [params.searchResults]);

  const [tempMinRating, setTempMinRating] = useState(0);
  const [tempMaxRating, setTempMaxRating] = useState(5);
  const [tempMinDistance, setTempMinDistance] = useState(0);
  const [tempMaxDistance, setTempMaxDistance] = useState(50);
  const [minRating, setMinRating] = useState(0);
  const [maxRating, setMaxRating] = useState(5);
  const [minDistance, setMinDistance] = useState(0);
  const [maxDistance, setMaxDistance] = useState(50);
  const [tempIsVerified, setTempIsVerified] = useState(false);
  const [tempIsPremium, setTempIsPremium] = useState(false);
  const [isVerified, setIsVerified] = useState(false);
  const [isPremium, setIsPremium] = useState(false);
  const [filteredResults, setFilteredResults] = useState(searchResults);

  const allDistancesNull = useMemo(
    () => Array.isArray(searchResults) && searchResults.length > 0 && searchResults.every((shop) => shop?.distance == null),
    [searchResults]
  );

  const isMountedRef = useRef(true);

  useEffect(() => {
    setMinRating(0);
    setMaxRating(5);
    setMinDistance(0);
    setMaxDistance(50);
    setTempMinRating(0);
    setTempMaxRating(5);
    setTempMinDistance(0);
    setTempMaxDistance(50);
    setTempIsVerified(false);
    setTempIsPremium(false);
    setIsVerified(false);
    setIsPremium(false);
    setFilteredResults(Array.isArray(searchResults) ? searchResults : []);

    return () => {
      isMountedRef.current = false;
    };
  }, [searchResults]);

  useEffect(() => {
    if (!Array.isArray(searchResults)) {
      console.warn('searchResults is not an array:', searchResults);
      setFilteredResults([]);
      return;
    }

    const results = searchResults.filter((shop) => {
      if (!shop || typeof shop !== 'object') return false;

      const rating = shop.average_rating ?? 0;
      const distance = shop.distance ?? null;
      const verified = shop.verified ?? false;
      const plan = shop.plan?.toLowerCase() ?? 'free';

      const ratingCheck = rating >= minRating && rating <= maxRating;
      let distanceCheck = true;
      const verifiedCheck = !isVerified || verified;
      const premiumCheck = !isPremium || (plan === 'standard' || plan === 'premium');

      if (!allDistancesNull && distance !== null) {
        distanceCheck = distance >= minDistance && distance <= maxDistance;
      }

      return ratingCheck && distanceCheck && verifiedCheck && premiumCheck;
    });

    if (isMountedRef.current) {
      setFilteredResults(results);
    }
  }, [minRating, maxRating, minDistance, maxDistance, isVerified, isPremium, searchResults, allDistancesNull]);

  useEffect(() => {
    if (loading || !isMountedRef.current) return;

    const checkAd = async () => {
      if (!['regular', 'standard', 'premium'].includes(subscriptionStatus)) {
        const count = parseInt(await AsyncStorage.getItem('searchCount') || '0', 10);
        if (count >= 3 && adLoaded) {
          setShowAd(true);
          await showInterstitial();
          setShowAd(false);
        }
      }
    };

    checkAd();

    return () => {
      isMountedRef.current = false;
    };
  }, [subscriptionStatus, loading, adLoaded, showInterstitial]);

  useFocusEffect(
    useCallback(() => {
      if (__DEV__) console.log('SearchResults focused');
      return () => {
        if (__DEV__) console.log('SearchResults unfocused');
      };
    }, [])
  );

  const handleFilterPress = useCallback(() => {
    if (['regular', 'standard', 'premium'].includes(subscriptionStatus)) {
      setModalVisible(true);
    } else {
      setSubscriptionModalVisible(true);
    }
  }, [subscriptionStatus]);

  const applyFilters = useCallback(() => {
    setMinRating(tempMinRating);
    setMaxRating(tempMaxRating);
    if (!allDistancesNull) {
      setMinDistance(tempMinDistance);
      setMaxDistance(tempMaxDistance);
    }
    setIsVerified(tempIsVerified);
    setIsPremium(tempIsPremium);
    setModalVisible(false);
  }, [tempMinRating, tempMaxRating, tempMinDistance, tempMaxDistance, tempIsVerified, tempIsPremium, allDistancesNull]);

  const resetFilters = useCallback(() => {
    setTempMinRating(0);
    setTempMaxRating(5);
    setMinRating(0);
    setMaxRating(5);
    if (!allDistancesNull) {
      setTempMinDistance(0);
      setTempMaxDistance(50);
      setMinDistance(0);
      setMaxDistance(50);
    }
    setTempIsVerified(false);
    setTempIsPremium(false);
    setIsVerified(false);
    setIsPremium(false);
    setFilteredResults(Array.isArray(searchResults) ? searchResults : []);
  }, [allDistancesNull, searchResults]);

  const renderShopCard = useCallback(
    ({ item, index }) => (
      <Animated.View entering={FadeInUp.delay(index * 100).duration(300)}>
        <TouchableOpacity
          style={styles.shopCard}
          activeOpacity={0.9}
          onPress={() => {
            router.push({
              pathname: '/shop/shop-page',
              params: { shopId: item.id },
            });
          }}
        >
          <View style={styles.imageContainer}>
            {item.image ? (
              <Image
                source={{ uri: `https://retail-alvinia-goza-f6a0e4f7.koyeb.app${item.image}` }}
                style={styles.shopImage}
                resizeMode="cover"
              />
            ) : (
              <LinearGradient
                colors={['#E5E7EB', '#D1D5DB']}
                style={[styles.shopImage, styles.placeholderImage]}
              >
                <MaterialIcons name="store" size={40} color="#6B7280" />
              </LinearGradient>
            )}
            <LinearGradient
              colors={['transparent', 'rgba(0,0,0,0.5)']}
              style={styles.imageGradient}
            />
            <View style={styles.shopNameContainer}>
              <Text style={styles.shopNameOverlay} numberOfLines={1} ellipsizeMode="tail">
                {item.name || 'Unnamed Shop'}
              </Text>
            </View>
            {(item.average_rating !== null || item.verified || item.plan === 'standard' || item.plan === 'premium') && (
              <View style={styles.ratingContainer}>
                {item.verified && (
                  <View style={styles.verifiedBadge}>
                    <MaterialIcons name="verified-user" size={16} color="#FFFFFF" />
                  </View>
                )}
                {item.average_rating !== null && (
                  <View style={styles.ratingBadge}>
                    <MaterialIcons name="star-rate" size={16} color="#1F2937" />
                    <Text style={styles.ratingText}>{item.average_rating.toFixed(1)}</Text>
                  </View>
                )}
                {(item.plan === 'standard' || item.plan === 'premium') && (
                  <View style={styles.planBadge}>
                    <MaterialIcons name="diamond" size={16} color="#FFFFFF" />
                  </View>
                )}
              </View>
            )}
          </View>
          <View style={styles.shopContent}>
            <View style={styles.shopInfo}>
              <View style={styles.row}>
                <MaterialIcons name="place" size={16} color="#6B7280" />
                <Text style={styles.shopAddress} numberOfLines={2}>
                  {item.address || 'No Address'}
                </Text>
              </View>
              <View style={styles.row}>
                <MaterialIcons name="directions" size={16} color="#6B7280" />
                <Text style={styles.shopDistance}>
                  {item.distance !== null && item.distance !== undefined ? `${item.distance.toFixed(1)} km` : 'N/A'}
                </Text>
              </View>
            </View>
            <Animated.View entering={ZoomIn.delay(index * 100 + 200).duration(200)} style={styles.goToShopButton}>
              <TouchableOpacity activeOpacity={0.7}>
                <LinearGradient
                  colors={['#22C55E', '#15803D']}
                  style={styles.buttonGradient}
                >
                  <MaterialIcons name="storefront" size={18} color="#fff" />
                  <Text style={styles.buttonText}>Visit</Text>
                </LinearGradient>
              </TouchableOpacity>
            </Animated.View>
          </View>
        </TouchableOpacity>
      </Animated.View>
    ),
    [router]
  );

  const keyExtractor = useCallback((item) => item.id.toString(), []);

  if (loading || showAd) {
    return (
      <SafeAreaView style={styles.loader}>
        <ActivityIndicator size="large" color="#007BFF" />
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={{ flex: 1 }} edges={['top', 'left', 'right']}>
      <StatusBar barStyle="light-content" backgroundColor="#2563EB" />
      <LinearGradient colors={['#F5F5F5', '#E0E0E0']} style={styles.container}>
        <View style={styles.header}>
          <TouchableOpacity onPress={() => router.navigate("(tabs)/shop")} style={styles.backButton}>
            <MaterialIcons name="arrow-back" size={26} color="white" />
          </TouchableOpacity>
          <Text style={styles.headerTitle}>Search Results</Text>
          <View style={styles.headerSpacer} />
        </View>
        <Animated.View entering={FadeInUp.duration(300)}>
          <TouchableOpacity onPress={handleFilterPress} style={styles.filterContainer}>
            <Ionicons name="filter-outline" size={20} color="#2563EB" />
            <Text style={styles.filterText}>Filter Results</Text>
          </TouchableOpacity>
        </Animated.View>
        <FlatList
          data={filteredResults}
          keyExtractor={keyExtractor}
          renderItem={renderShopCard}
          ListEmptyComponent={<Text style={styles.noResults}>No shops found.</Text>}
          contentContainerStyle={styles.listContainer}
          initialNumToRender={10}
          maxToRenderPerBatch={10}
          windowSize={5}
          showsVerticalScrollIndicator={false}
        />
      </LinearGradient>
      <Modal visible={subscriptionModalVisible} animationType="slide" transparent>
        <View style={styles.modalOverlay}>
          <View style={styles.modalContainer}>
            <SubscriptionRequired onClose={() => setSubscriptionModalVisible(false)} />
            <TouchableOpacity onPress={() => setSubscriptionModalVisible(false)} style={styles.closeButton}>
              <Text style={styles.closeButtonText}>Close</Text>
            </TouchableOpacity>
          </View>
        </View>
      </Modal>
      <Modal visible={modalVisible} animationType="fade" transparent>
        <View style={styles.modalOverlay}>
          <KeyboardAvoidingView behavior="padding" style={styles.modalContainer}>
            <Animated.View entering={ZoomIn.duration(300)} style={styles.modalContent}>
              <TouchableOpacity onPress={() => setModalVisible(false)} style={styles.modalCloseButton}>
                <Ionicons name="close" size={28} color="#333" />
              </TouchableOpacity>
              <Text style={styles.filterTitle}>Filter Options</Text>
              <View style={styles.sliderContainer}>
                <Text style={styles.sliderLabel}>Rating: {tempMinRating.toFixed(1)} - {tempMaxRating.toFixed(1)}</Text>
                <Slider
                  minimumValue={0}
                  maximumValue={5}
                  step={0.1}
                  value={tempMinRating}
                  onValueChange={setTempMinRating}
                  minimumTrackTintColor="#2563EB"
                  thumbTintColor="#2563EB"
                  style={styles.slider}
                />
                <Slider
                  minimumValue={0}
                  maximumValue={5}
                  step={0.1}
                  value={tempMaxRating}
                  onValueChange={setTempMaxRating}
                  minimumTrackTintColor="#2563EB"
                  thumbTintColor="#2563EB"
                  style={styles.slider}
                />
              </View>
              {!allDistancesNull && (
                <View style={styles.sliderContainer}>
                  <Text style={styles.sliderLabel}>Distance: {tempMinDistance.toFixed(1)} - {tempMaxDistance.toFixed(1)} km</Text>
                  <Slider
                    minimumValue={0}
                    maximumValue={50}
                    step={0.1}
                    value={tempMinDistance}
                    onValueChange={setTempMinDistance}
                    minimumTrackTintColor="#2563EB"
                    thumbTintColor="#2563EB"
                    style={styles.slider}
                  />
                  <Slider
                    minimumValue={0}
                    maximumValue={50}
                    step={0.1}
                    value={tempMaxDistance}
                    onValueChange={setTempMaxDistance}
                    minimumTrackTintColor="#2563EB"
                    thumbTintColor="#2563EB"
                    style={styles.slider}
                  />
                </View>
              )}
              {allDistancesNull && (
                <Text style={styles.noDistanceText}>Distance filtering unavailable for this search.</Text>
              )}
              <View style={styles.switchContainer}>
                <View style={styles.switchRow}>
                  <Text style={styles.switchLabel}>Verified Shops Only</Text>
                  <Switch
                    value={tempIsVerified}
                    onValueChange={setTempIsVerified}
                    trackColor={{ false: '#D1D5DB', true: '#2563EB' }}
                    thumbColor={tempIsVerified ? '#FFFFFF' : '#F4F4F5'}
                  />
                </View>
                <Text style={styles.switchDescription}>Show only shops with verified owners.</Text>
              </View>
              <View style={styles.switchContainer}>
                <View style={styles.switchRow}>
                  <Text style={styles.switchLabel}>Premium Shops Only</Text>
                  <Switch
                    value={tempIsPremium}
                    onValueChange={setTempIsPremium}
                    trackColor={{ false: '#D1D5DB', true: '#2563EB' }}
                    thumbColor={tempIsPremium ? '#FFFFFF' : '#F4F4F5'}
                  />
                </View>
                <Text style={styles.switchDescription}>Show only shops with Standard or Premium plans that can generate receipts.</Text>
              </View>
              <View style={styles.buttonRow}>
                <TouchableOpacity onPress={resetFilters} style={styles.resetButton}>
                  <Text style={styles.resetButtonText}>Reset</Text>
                </TouchableOpacity>
                <TouchableOpacity onPress={applyFilters} style={styles.applyButton}>
                  <Text style={styles.applyButtonText}>Apply</Text>
                </TouchableOpacity>
              </View>
            </Animated.View>
          </KeyboardAvoidingView>
        </View>
      </Modal>
    </SafeAreaView>
  );
};

